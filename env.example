export FREYA_API_KEY=fak_your_key_here                 # from your Freya workspace, under API keys
export FREYA_API_URL=https://staging-app.freyavoice.ai
export FREYA_BANK_TEAM_KEY=pick-any-secret-of-16-or-more-characters   # you make this up. Use the same one every time.

# The extractor needs Claude Code credentials on top of this file: either an interactive `claude` login or a real
# ANTHROPIC_API_KEY (sk-ant-…). Pre-flight before Sunday:  claude -p "say OK"
# Optional builder knobs (defaults shown; set only to change them):
# export BUILDER_MODEL=claude-opus-5-5                  # model used for the extraction/audit/repair passes
# export EXTRACT_PASS_TIMEOUT_S=420                    # max seconds per model pass
