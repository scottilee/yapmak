    "role_message": "",
    "task_message": "You are collecting the answer to: Am I speaking with Alex Morgan? If the caller trails off, ask them to finish. If they ask a question, answer briefly. Do not invent an amount, date, time or consent. Do not say any action has been recorded. Keep replies short. For a callback, ask for the missing day or exact clock time. Otherwise ask them to clarify or continue.",
    "interruptible": true,
    "max_node_turns": 12,
    "response_mapping": [],
    "extraction_schema": [
     {
      "name": "holder",
      "type": "string",
      "description": "Who is on the line, from the LAST message. confirmed ONLY if the person answered yes, that's me, speaking, or said the customer's own name {{first_name}} {{last_name}}. third_party if they said they are someone else (husband, wife, relative, friend, colleague) or that the customer is not available. wrong_number if they said the number does not belong to the customer. deceased if they said the customer has died. wants_human if they ask for a human agent. refuses if they say they do not want to talk. question if they asked something without confirming (who is this, is this a robot, is this a scam, what is this about). unclear for hello, go ahead, or anything else.",
      "enum_values": [
       "confirmed",
       "third_party",
       "wrong_number",
       "deceased",
       "wants_human",
       "refuses",
       "question",
       "unclear",
       "none"
      ],
      "min_confidence": 0.5
     }
    ],
