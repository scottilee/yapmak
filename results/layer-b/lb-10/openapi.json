{
 "openapi": "3.0.3",
 "info": {
  "title": "Freya Bank collections tools",
  "version": "0.3-draft",
  "description": "Mock of the bank's systems for the Build the Builder hackathon. We host it. Every call is written to the ledger the scorer reads. The service does not enforce the brief: it records a promise on a holiday or past the deadline without complaint. Following the brief is the agent's job. The seven tool calls need no key: the customer_id in the body is the secret of one call."
 },
 "servers": [
  {
   "url": "https://freya-bank-mock.freyavoice.workers.dev/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "field": {
          "type": "string",
          "enum": [
           "date_of_birth",
           "phone_last4"
          ]
         },
         "answer": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "field",
         "answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "wrong_answers_left": {
           "type": "integer"
          },
          "all_verified": {
           "type": "boolean"
          },
          "hint": {
           "type": "string",
           "enum": [
            "day_month_swapped"
           ]
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  },
  "/get_account": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "products": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "product_id": {
              "type": "string"
             },
             "type": {
              "type": "string",
              "enum": [
               "credit_card",
               "personal_loan",
               "car_loan"
              ]
             },
             "card_last4": {
              "type": "string"
             },
             "past_due": {
              "type": "number"
             },
             "days_late": {
              "type": "integer"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  },
  "/create_promise": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "amount": {
          "type": "number"
         },
         "date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "amount",
         "date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  },
  "/add_note": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "refused",
           "hardship",
           "dispute",
           "paid",
           "service_error"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "time": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "date",
         "time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "restructuring",
           "general",
           "support"
          ]
         }
        },
        "required": [
         "customer_id",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  },
  "/close_call": {
   "post": {
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "promise",
           "paid",
           "transferred",
           "no_promise",
           "not_verified",
           "not_reached"
          ]
         },
         "reason": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {}
    }
   }
  }
 }
}