 # =============================================================================================
 # Prompts (deterministic defaults; an LLM-authored PromptSet can override any stage)
 # =============================================================================================
+def sc_clause(ir, name: str, fallback: str) -> str:
+    """`mentions illness, ...` text for intent descriptions: the named special case's `trigger`
+    from the brief, so the routing vocabulary follows the policy, with Brief A's words only as fallback."""
+    t = ""
+    for sc in ir.special_cases:
+        if sc.name == name and (sc.trigger or "").strip():
+            t = sc.trigger.strip()
+            break
+    if not t:
+        return fallback
+    t = re.sub(r"^(the\s+)?customers?['’]?\s?", "", t, flags=re.I)
+    t = re.sub(r"^who\s+|^that\s+", "", t, flags=re.I)
+    t = t.rstrip(" .!") or fallback
+    if len(t) > 1 and t[0].isupper() and t[1].islower():
+        t = t[0].lower() + t[1:]
+    return t
+
+
