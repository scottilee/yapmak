# Credentials and machine-local environment (keep shareable examples).
.env
.env.*
!.env.example
!.env.sample
env.sh
*.pem
*.key
.claude/settings.local.json
.sbx/

# Python environments, bytecode, and disposable test/tool caches.
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
*.egg-info/

# Local Freya workspace/persona identifiers; these are recreated per workspace.
.freya-agents.json
.freya-agents.json.lock
.personas.json
freya-agent-builder-implementation-plan.md

# OS/editor scratch files.
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Isolated baseline starter-kit copies; copy their final evidence to the parent
# results/example-builder directory before committing. Do not ignore all logs,
# traces/, out/, results/, or submission/: selected artifacts are required evidence.
/results/example-builder/*/kit/

# Large raw call dumps are kept locally; traces and scored results stay tracked.
results/**/calls.json

# generated policy permutations (regenerate with scripts/permute_policies.py --run); the summary is kept
results/permutations/perm-*.json
mock/node_modules/
mock/.wrangler/
