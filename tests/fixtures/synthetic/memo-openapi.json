{
 "openapi": "3.0.3",
 "info": {
  "title": "Northbridge Mutual mock (synthetic)",
  "version": "1.0"
 },
 "servers": [
  {
   "url": "https://northbridge-mock.example/v1"
  }
 ],
 "components": {},
 "paths": {
  "/verify_identity": {
   "post": {
    "summary": "Check one security answer. Three wrong answers in total end the check.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "field": {
          "type": "string",
          "enum": [
           "postcode",
           "founded_year",
           "company_number"
          ]
         },
         "answer": {
          "type": "string",
          "description": "postcode as letters and digits without spaces; founded_year as YYYY; company_number as eight digits."
         }
        },
        "required": [
         "customer_id",
         "field",
         "answer"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "all_verified": {
           "type": "boolean"
          },
          "hint": {
           "type": "string",
           "enum": [
            "day_month_swapped"
           ]
          },
          "attempts_remaining": {
           "type": "integer"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/get_account": {
   "post": {
    "summary": "The late products. Refused until both questions are passed.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "facilities": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "product_id": {
              "type": "string"
             },
             "type": {
              "type": "string",
              "enum": [
               "business_overdraft",
               "equipment_loan",
               "trade_finance_line"
              ]
             },
             "arrears": {
              "type": "number"
             },
             "days_in_arrears": {
              "type": "integer"
             },
             "minimum_due": {
              "type": "number",
              "description": "credit cards only"
             },
             "scheduled_repayment": {
              "type": "number",
              "description": "loans only"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/create_promise": {
   "post": {
    "summary": "Record a payment promise. One per product.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "amount": {
          "type": "number"
         },
         "date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "amount",
         "date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "promise_id": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Brief B: record why a product ended without a promise.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "product_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "declined_payment",
           "distress",
           "disputed",
           "settled",
           "system_error"
          ]
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "product_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "time": {
          "type": "string",
          "description": "HH:MM"
         }
        },
        "required": [
         "customer_id",
         "date",
         "time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/transfer_to_agent": {
   "post": {
    "summary": "Hand the call to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "queue": {
          "type": "string",
          "enum": [
           "restructure",
           "desk",
           "care"
          ]
         }
        },
        "required": [
         "customer_id",
         "queue"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "arrangement",
           "settled",
           "handed_over",
           "no_arrangement",
           "unverified",
           "unreached"
          ]
         },
         "reason": {
          "type": "string",
          "description": "Required for every outcome except promise and paid. See the table in the brief."
         }
        },
        "required": [
         "customer_id",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     },
     "500": {
      "description": "The service failed. Nothing was recorded. The call may be repeated."
     }
    }
   }
  }
 }
}