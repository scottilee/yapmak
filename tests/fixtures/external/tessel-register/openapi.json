{
  "openapi": "3.0.3",
  "info": {
    "title": "Tessel Savings Bank fictional campaign API",
    "version": "2026-10"
  },
  "servers": [
    {
      "url": "https://tessel-register.example.invalid"
    }
  ],
  "paths": {
    "/ledger/verify_identity": {
      "post": {
        "operationId": "verify_identity",
        "summary": "verify_identity for Tessel Savings Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "field": {
                    "type": "string",
                    "description": "Security question identifier.",
                    "enum": [
                      "district",
                      "opening_year",
                      "token"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "description": "Complete normalized security answer; formats and question order are specified by the effective policy."
                  }
                },
                "required": [
                  "customer_id",
                  "field",
                  "answer"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    },
                    "answer_ok": {
                      "type": "boolean",
                      "description": "Whether this completed security answer passed."
                    },
                    "identity_ok": {
                      "type": "boolean",
                      "description": "True only after all required questions passed."
                    },
                    "tries_left": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Authoritative remaining wrong answers across the entire check."
                    }
                  },
                  "required": [
                    "success",
                    "answer_ok",
                    "identity_ok",
                    "tries_left"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    },
    "/ledger/get_account": {
      "post": {
        "operationId": "get_account",
        "summary": "get_account for Tessel Savings Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  }
                },
                "required": [
                  "customer_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    },
                    "cartera": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "contrato": {
                            "type": "string",
                            "description": "Unique product identifier; use in product-specific writes."
                          },
                          "clase": {
                            "type": "string",
                            "description": "Product type.",
                            "enum": [
                              "giro",
                              "plazo"
                            ]
                          },
                          "amt_due": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Full past-due amount."
                          },
                          "dl_days": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "Days late, determines the band."
                          }
                        },
                        "required": [
                          "contrato",
                          "clase",
                          "amt_due",
                          "dl_days"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    },
    "/ledger/create_promise": {
      "post": {
        "operationId": "create_promise",
        "summary": "create_promise for Tessel Savings Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "product_id": {
                    "type": "string",
                    "description": "Product identifier from contrato in get_account."
                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": true,
                    "minimum": 0,
                    "description": "Promised payment amount, not the original balance."
                  },
                  "date": {
                    "type": "string",
                    "description": "Promised payment date.",
                    "format": "date"
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "amount",
                  "date"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    },
                    "receipt": {
                      "type": "string",
                      "description": "Receipt identifier only when a promise was saved."
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    },
    "/ledger/add_note": {
      "post": {
        "operationId": "add_note",
        "summary": "add_note for Tessel Savings Bank. Retained for interface compatibility; this campaign MUST NOT call this operation.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "product_id": {
                    "type": "string",
                    "description": "Product identifier from contrato."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Product note reason; never infer permission from tool availability.",
                    "enum": [
                      "R10",
                      "R17",
                      "R99"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "description": "Optional note text."
                  }
                },
                "required": [
                  "customer_id",
                  "product_id",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    },
    "/ledger/schedule_callback": {
      "post": {
        "operationId": "schedule_callback",
        "summary": "schedule_callback for Tessel Savings Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "date": {
                    "type": "string",
                    "description": "Callback date.",
                    "format": "date"
                  },
                  "time": {
                    "type": "string",
                    "description": "Callback local clock time HH:MM.",
                    "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
                  }
                },
                "required": [
                  "customer_id",
                  "date",
                  "time"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    },
    "/ledger/transfer_to_agent": {
      "post": {
        "operationId": "transfer_to_agent",
        "summary": "transfer_to_agent for Tessel Savings Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "queue": {
                    "type": "string",
                    "description": "Destination queue.",
                    "enum": [
                      "Desk-4",
                      "Care-4"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "queue"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
