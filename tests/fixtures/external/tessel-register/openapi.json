                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    },
    "/ledger/close_call": {
      "post": {
        "operationId": "close_call",
        "summary": "close_call for Tessel Savings Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "outcome": {
                    "type": "string",
                    "description": "Final outcome.",
                    "enum": [
                      "10",
                      "20",
                      "30",
                      "40",
                      "50"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Omit when the code table has no reason. Only listed outcome/reason pairs are valid.",
                    "enum": [
                      "R10",
                      "R17",
                      "R99",
                      "R30",
                      "R31",
                      "R40",
                      "R41",
                      "R50",
                      "R51",
                      "R52",
                      "R53",
                      "R54"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "outcome"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
            "description": "Nothing was saved. Retry only as the effective policy permits."
          }
        }
      }
    }
  }
