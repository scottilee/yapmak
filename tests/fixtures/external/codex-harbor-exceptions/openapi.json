                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "disposition": {
                    "type": "string",
                    "description": "Final outcome code.",
                    "enum": [
                      "hg-promised",
                      "hg-settled",
                      "hg-routed",
                      "hg-unarranged",
                      "hg-unverified",
                      "hg-unreached"
                    ]
                  },
                  "closing_reason": {
                    "type": "string",
                    "description": "Reason code, omitted for reasonless outcomes.",
                    "enum": [
                      "hg-r-replan",
                      "hg-r-person",
                      "hg-r-care",
                      "hg-r-refused",
                      "hg-r-distress",
                      "hg-r-disputed",
                      "hg-r-service",
                      "hg-r-failed",
                      "hg-r-declined",
                      "hg-r-callback",
                      "hg-r-no-callback",
                      "hg-r-wrong-number",
                      "hg-r-deceased",
                      "hg-r-unclear"
                    ]
