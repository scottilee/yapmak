{
  "openapi": "3.0.3",
  "info": {
    "title": "Harbor Glass Cooperative Collections Sandbox",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://codex-harbor-exceptions.example.invalid"
    }
