  "paths": {
    "/case/get_account": {
      "post": {
        "operationId": "get_account",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  }
                },
                "required": [
                  "client_ref"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "holdings": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "properties": {
                          "holding_id": {
                            "type": "string",
                            "description": "Identifier of the specific product returned by get_account; never use its display name."
                          },
                          "holding_kind": {
                            "type": "string",
                            "description": "Product type; selects the corresponding minimum amount field.",
                            "enum": [
                              "hg-cycle",
                              "hg-tool",
                              "hg-trade"
                            ]
                          },
                          "arrears_value": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Full currently overdue amount."
                          },
                          "delinquent_days": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 70,
                            "description": "Days late used to choose the policy band."
                          },
                          "cycle_min": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Minimum acceptable promise amount for hg-cycle; populated only for that type."
                          },
                          "tool_min": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Minimum acceptable promise amount for hg-tool; populated only for that type."
                          },
                          "trade_min": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Minimum acceptable promise amount for hg-trade; populated only for that type."
                          }
                        },
                        "required": [
                          "holding_id",
                          "holding_kind",
                          "arrears_value",
                          "delinquent_days"
                        ],
                        "additionalProperties": false
                      },
                      "description": "All overdue products in the order to discuss them."
                    }
                  },
                  "required": [
                    "request_success",
                    "holdings"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "request_success",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/case/verify_identity": {
      "post": {
        "operationId": "verify_identity",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "check_key": {
                    "type": "string",
                    "description": "Identity requirement key.",
                    "enum": [
                      "passphrase",
                      "enrolment_year",
                      "phone_suffix",
                      "signatory_dob"
                    ]
                  },
                  "answer_text": {
                    "type": "string",
                    "description": "Normalized answer: dates YYYY-MM-DD, digit strings preserve leading zeros; text remains text; year is four digits."
                  }
                },
                "required": [
                  "client_ref",
                  "check_key",
                  "answer_text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "matched": {
                      "type": "boolean",
                      "description": "This answer passed the named security check."
                    },
                    "complete": {
                      "type": "boolean",
                      "description": "All required security checks have passed."
                    },
                    "attempts_available": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4,
                      "description": "Global number of wrong answers still allowed across all questions."
                    }
                  },
                  "required": [
                    "request_success",
                    "matched",
                    "complete",
                    "attempts_available"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "request_success",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
