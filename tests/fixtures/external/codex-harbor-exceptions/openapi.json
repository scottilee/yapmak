                  "due_on": {
                    "type": "string",
                    "description": "Confirmed promise date.",
                    "format": "date"
                  }
                },
                "required": [
                  "client_ref",
                  "holding_id",
                  "promised_amount",
                  "due_on"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    }
                  },
                  "required": [
                    "request_success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "request_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
