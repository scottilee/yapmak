{
  "openapi": "3.0.3",
  "info": {
    "title": "Kurilian Co-operative Bank collections API",
    "version": "kcb-1"
  },
  "servers": [
    {
      "url": "https://kcb-1.example.invalid/v1"
    }
  ],
  "components": {},
  "paths": {
    "/col/verify_identity": {
      "post": {
        "summary": "Check the single security answer required by call sheet KCB-1; tries_left is authoritative.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  },
                  "field": {
                    "type": "string",
                    "enum": [
                      "sec_code"
                    ]
                  },
                  "answer": {
                    "type": "string",
                    "description": "sec_code: exactly four digits, leading zeros preserved."
                  }
                },
                "required": [
                  "cust_ref",
                  "field",
                  "answer"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    },
                    "verified": {
                      "type": "boolean"
                    },
                    "all_verified": {
                      "type": "boolean"
                    },
                    "tries_left": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "verify_identity"
      }
    },
    "/col/get_account": {
      "post": {
        "summary": "Return the single overdue loan after the security answer passes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  }
                },
                "required": [
                  "cust_ref"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    },
                    "obligations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "product_id": {
                            "type": "string"
                          },
                          "prod_kind": {
                            "type": "string",
                            "enum": [
                              "loan"
                            ]
                          },
                          "amt_due": {
                            "type": "number",
                            "minimum": 0.01
                          },
                          "dl_days": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 90
                          }
                        }
                      },
                      "minItems": 1,
                      "maxItems": 1
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "get_account"
      }
    },
    "/col/create_promise": {
      "post": {
        "summary": "Record a promise. One per loan; only the full amt_due is recordable.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "cust_ref",
                  "product_id",
                  "amount",
                  "date"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "promise_id": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "create_promise"
      }
    },
    "/col/add_note": {
      "post": {
        "summary": "Not used by call sheet KCB-1.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  },
                  "product_id": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "R07"
                    ]
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "cust_ref",
                  "product_id",
                  "reason"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "add_note"
      }
    },
    "/col/schedule_callback": {
      "post": {
        "summary": "Not used by call sheet KCB-1.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string",
                    "format": "date"
                  },
                  "time": {
                    "type": "string",
                    "description": "HH:MM"
                  }
                },
                "required": [
                  "cust_ref",
                  "date",
                  "time"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "schedule_callback"
      }
    },
    "/col/transfer_to_agent": {
      "post": {
        "summary": "Hand the call to a human when the customer asks for a person.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  },
                  "queue": {
                    "type": "string",
                    "enum": [
                      "kcb_desk"
                    ]
                  }
                },
                "required": [
                  "cust_ref",
                  "queue"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "transfer_to_agent"
      }
    },
    "/col/close_call": {
      "post": {
        "summary": "End the call. Always the last tool call. Nothing is accepted after it.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string"
                  },
                  "outcome": {
                    "type": "string",
                    "enum": [
                      "PTP",
                      "No-PTP",
                      "DEC",
                      "VOID",
                      "transferred"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "R07",
                      "F01",
                      "F02",
                      "RNG",
                      "JCB-unclear",
                      "kcb_person"
                    ],
                    "description": "Omit reason for PTP. Other combinations are fixed by the codes sheet."
                  }
                },
                "required": [
                  "cust_ref",
                  "outcome"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "`success` is false when the bank action was not carried out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "string"
                    },
                    "success": {
                      "type": "boolean",
                      "description": "True only when the bank operation succeeded; HTTP status alone does not authorize a success claim."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "The service failed and nothing was recorded."
          }
        },
        "operationId": "close_call"
      }
    }
  }
}