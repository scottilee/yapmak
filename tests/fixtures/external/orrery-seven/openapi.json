    "/ledger/close_call": {
      "post": {
        "operationId": "close_call",
        "summary": "close_call for Orrery Community Bank.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cust_ref": {
                    "type": "string",
                    "description": "Call variable customer_id; customer reference, not a product identifier."
                  },
                  "resultado": {
                    "type": "string",
                    "description": "Final outcome.",
                    "enum": [
                      "PTP",
                      "No-PTP",
                      "Xfer",
                      "ID0",
                      "NR0"
                    ]
                  },
                  "motivo": {
                    "type": "string",
                    "description": "Omit when the code table has no reason. Only listed outcome/reason pairs are valid.",
                    "enum": [
                      "R01",
                      "R07",
                      "R99",
                      "H1",
                      "F1",
                      "D1",
                      "U0",
                      "N0",
                      "W0",
                      "D0"
                    ]
                  }
                },
                "required": [
                  "cust_ref",
                  "resultado"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inspect success; an unsuccessful response has no completed bank action.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "description": "True only when this operation completed; HTTP 200 alone is not success."
                    },
                    "error": {
                      "type": "string",
                      "description": "Present on failure."
                    }
                  },
                  "required": [
                    "success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "500": {
