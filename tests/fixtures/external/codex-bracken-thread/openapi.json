{
  "openapi": "3.0.3",
  "info": {
    "title": "Bracken Exchange Bank Collections Sandbox",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://codex-bracken-thread.example.invalid"
    }
  ],
  "paths": {
    "/case/get_account": {
      "post": {
        "operationId": "get_account",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  }
                },
                "required": [
                  "client_ref"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "accounts": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "properties": {
                          "account_ref": {
                            "type": "string",
                            "description": "Identifier of the specific product returned by get_account; never use its display name."
                          },
                          "category": {
                            "type": "string",
                            "description": "Product type; selects the corresponding minimum amount field.",
                            "enum": [
                              "br-cycle",
                              "br-tool",
                              "br-trade"
                            ]
                          },
                          "overdue_amount": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Full currently overdue amount."
                          },
                          "arrears_days": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 80,
                            "description": "Days late used to choose the policy band."
                          },
                          "cycle_floor": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Minimum acceptable promise amount for br-cycle; populated only for that type."
                          },
                          "tool_floor": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Minimum acceptable promise amount for br-tool; populated only for that type."
                          },
                          "trade_floor": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Minimum acceptable promise amount for br-trade; populated only for that type."
                          }
                        },
                        "required": [
                          "account_ref",
                          "category",
                          "overdue_amount",
                          "arrears_days"
                        ],
                        "additionalProperties": false,
                        "oneOf": [
                          {
                            "properties": {
                              "category": {
                                "enum": [
                                  "br-cycle"
                                ]
                              }
                            },
                            "required": [
                              "cycle_floor"
                            ]
                          },
                          {
                            "properties": {
                              "category": {
                                "enum": [
                                  "br-tool"
                                ]
                              }
                            },
                            "required": [
                              "tool_floor"
                            ]
                          },
                          {
                            "properties": {
                              "category": {
                                "enum": [
                                  "br-trade"
                                ]
                              }
                            },
                            "required": [
                              "trade_floor"
                            ]
                          }
                        ]
                      },
                      "description": "All overdue products in the order to discuss them."
                    }
                  },
                  "required": [
                    "operation_success",
                    "accounts"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "operation_success",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/case/verify_identity": {
      "post": {
        "operationId": "verify_identity",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "check_key": {
                    "type": "string",
                    "description": "Identity requirement key.",
                    "enum": [
                      "security_phrase",
                      "joining_year",
                      "contact_tail",
                      "responsible_dob"
                    ]
                  },
                  "answer_text": {
                    "type": "string",
                    "description": "Normalized answer: dates YYYY-MM-DD, digit strings preserve leading zeros; text remains text; year is four digits."
                  }
                },
                "required": [
                  "client_ref",
                  "check_key",
                  "answer_text"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "check_passed": {
                      "type": "boolean",
                      "description": "This answer passed the named security check."
                    },
                    "all_checks_complete": {
                      "type": "boolean",
                      "description": "All required security checks have passed."
                    },
                    "remaining_checks": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 5,
                      "description": "Global number of wrong answers still allowed across all questions."
                    }
                  },
                  "required": [
                    "operation_success",
                    "check_passed",
                    "all_checks_complete",
                    "remaining_checks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "operation_success",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/case/create_promise": {
      "post": {
        "operationId": "create_promise",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
