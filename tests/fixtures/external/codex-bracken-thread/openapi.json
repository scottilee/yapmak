            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "route_key": {
                    "type": "string",
                    "description": "Destination queue for the accepted handoff.",
                    "enum": [
                      "br-plan-desk",
                      "br-human-desk",
                      "br-care-desk"
                    ]
                  }
                },
                "required": [
                  "client_ref",
