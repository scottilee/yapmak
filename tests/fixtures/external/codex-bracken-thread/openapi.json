    "/case/close_call": {
      "post": {
        "operationId": "close_call",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "client_ref": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "closing_code": {
                    "type": "string",
                    "description": "Final outcome code.",
                    "enum": [
                      "br-promised",
                      "br-settled",
                      "br-routed",
                      "br-unarranged",
                      "br-unverified",
                      "br-unreached"
                    ]
                  },
                  "closing_reason": {
                    "type": "string",
                    "description": "Reason code, omitted for reasonless outcomes.",
                    "enum": [
                      "br-r-replan",
                      "br-r-person",
                      "br-r-care",
                      "br-r-refused",
                      "br-r-distress",
                      "br-r-disputed",
                      "br-r-service",
                      "br-r-failed",
                      "br-r-declined",
                      "br-r-callback",
                      "br-r-no-callback",
                      "br-r-wrong-number",
                      "br-r-deceased",
                      "br-r-unclear"
                    ]
                  }
                },
                "required": [
                  "client_ref",
                  "closing_code"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "properties": {
                      "closing_code": {
                        "enum": [
                          "br-promised"
                        ]
                      }
                    },
                    "not": {
                      "required": [
                        "closing_reason"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "closing_code": {
                        "enum": [
                          "br-settled"
                        ]
                      }
                    },
                    "not": {
                      "required": [
                        "closing_reason"
                      ]
                    }
                  },
                  {
                    "properties": {
                      "closing_code": {
                        "enum": [
                          "br-routed"
                        ]
                      },
                      "closing_reason": {
                        "enum": [
                          "br-r-replan",
                          "br-r-person",
                          "br-r-care"
                        ]
                      }
                    },
                    "required": [
                      "closing_reason"
                    ]
                  },
                  {
                    "properties": {
                      "closing_code": {
                        "enum": [
                          "br-unarranged"
                        ]
                      },
                      "closing_reason": {
                        "enum": [
                          "br-r-refused",
                          "br-r-distress",
                          "br-r-disputed",
                          "br-r-service"
                        ]
                      }
                    },
                    "required": [
                      "closing_reason"
                    ]
                  },
                  {
                    "properties": {
                      "closing_code": {
                        "enum": [
                          "br-unverified"
                        ]
                      },
                      "closing_reason": {
                        "enum": [
                          "br-r-failed",
                          "br-r-declined"
                        ]
                      }
                    },
                    "required": [
                      "closing_reason"
                    ]
                  },
                  {
                    "properties": {
                      "closing_code": {
                        "enum": [
                          "br-unreached"
                        ]
                      },
                      "closing_reason": {
                        "enum": [
                          "br-r-callback",
                          "br-r-no-callback",
                          "br-r-wrong-number",
                          "br-r-deceased",
                          "br-r-unclear"
                        ]
                      }
                    },
                    "required": [
                      "closing_reason"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    }
                  },
                  "required": [
                    "operation_success"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation_success": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "operation_success",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
