    "/case/add_note": {
      "post": {
        "operationId": "add_note",
        "description": "Endpoint is present for other bank programmes; this programme never authorizes notes. All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "contract_id": {
                    "type": "string",
                    "description": "Identifier of the specific product returned by get_account; never use its display name."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason this product has no recorded promise.",
                    "enum": [
                      "cr-r-refused",
                      "cr-r-distress",
                      "cr-r-disputed",
                      "cr-r-settled",
                      "cr-r-service"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "description": "Optional factual note."
                  }
                },
                "required": [
                  "customer_id",
                  "contract_id",
                  "reason"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
