                  },
                  "amount": {
                    "type": "number",
                    "exclusiveMinimum": false,
                    "minimum": 0,
                    "description": "Confirmed payment amount for this product."
                  },
                  "date": {
                    "type": "string",
                    "description": "Confirmed promise date.",
                    "format": "date"
                  }
                },
                "required": [
                  "customer_id",
                  "contract_id",
                  "amount",
                  "date"
                ],
                "additionalProperties": false
              }
            }
          }
