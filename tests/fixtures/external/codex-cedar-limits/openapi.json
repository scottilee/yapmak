{
  "openapi": "3.0.3",
  "info": {
    "title": "Cedar Reach Savings Collections Sandbox",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://codex-cedar-limits.example.invalid"
    }
  ],
  "paths": {
    "/case/get_account": {
      "post": {
        "operationId": "get_account",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  }
                },
                "required": [
                  "customer_id"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "contracts": {
                      "type": "array",
                      "maxItems": 1,
                      "items": {
                        "type": "object",
                        "properties": {
                          "contract_id": {
                            "type": "string",
                            "description": "Identifier of the specific product returned by get_account; never use its display name."
                          },
                          "contract_kind": {
                            "type": "string",
                            "description": "Product type; selects the corresponding minimum amount field.",
                            "enum": [
                              "cr-flex",
                              "cr-term"
                            ]
                          },
                          "overdue_total": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Full currently overdue amount."
                          },
                          "late_days": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 60,
                            "description": "Days late used to choose the policy band."
                          },
                          "flex_base": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Base minimum in dollars, not the final permitted promise floor. The policy requires the capped quarter-balance calculation."
                          },
                          "term_base": {
                            "type": "number",
                            "minimum": 0,
                            "description": "Base minimum in dollars, not the final permitted promise floor. The policy requires the capped quarter-balance calculation."
                          }
                        },
                        "required": [
                          "contract_id",
                          "contract_kind",
                          "overdue_total",
                          "late_days"
                        ],
                        "additionalProperties": false
                      },
                      "description": "All overdue products in the order to discuss them."
                    }
                  },
                  "required": [
                    "ok",
                    "contracts"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "ok",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/case/verify_identity": {
      "post": {
        "operationId": "verify_identity",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "field": {
                    "type": "string",
                    "description": "Identity requirement key.",
                    "enum": [
                      "birth_date",
                      "access_pin",
                      "locality_word"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "description": "Normalized answer: dates YYYY-MM-DD, digit strings preserve leading zeros; text remains text; year is four digits."
                  }
                },
                "required": [
                  "customer_id",
                  "field",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operation result; inspect success flag before saying it succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "verified": {
                      "type": "boolean",
                      "description": "This answer passed the named security check."
                    },
                    "all_verified": {
                      "type": "boolean",
                      "description": "All required security checks have passed."
                    }
                  },
                  "required": [
                    "ok",
                    "verified",
                    "all_verified"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "Service unavailable, nothing committed.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "True only if this operation succeeded; false means no write was committed."
                    },
                    "error": {
                      "type": "string",
                      "description": "Failure explanation."
                    }
                  },
                  "required": [
                    "ok",
                    "error"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/case/create_promise": {
      "post": {
        "operationId": "create_promise",
