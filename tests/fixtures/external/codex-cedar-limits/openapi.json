    "/case/close_call": {
      "post": {
        "operationId": "close_call",
        "description": "All calls require the customer identifier. Failure responses do not commit a write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer_id": {
                    "type": "string",
                    "description": "Customer identifier from the call customer_id variable."
                  },
                  "outcome": {
                    "type": "string",
                    "description": "Final outcome code.",
                    "enum": [
                      "cr-promised",
                      "cr-paid",
                      "cr-routed",
                      "cr-none",
                      "cr-unverified",
                      "cr-unreached"
                    ]
                  },
                  "reason": {
                    "type": "string",
                    "description": "Reason code, omitted for reasonless outcomes.",
                    "enum": [
                      "cr-r-replan",
                      "cr-r-person",
                      "cr-r-care",
                      "cr-r-refused",
                      "cr-r-distress",
                      "cr-r-disputed",
                      "cr-r-service",
                      "cr-r-failed",
                      "cr-r-declined",
                      "cr-r-callback",
                      "cr-r-no-callback",
                      "cr-r-wrong-number",
                      "cr-r-deceased",
                      "cr-r-unclear"
                    ]
                  }
                },
                "required": [
                  "customer_id",
                  "outcome"
                ],
                "additionalProperties": false
              }
            }
          }
